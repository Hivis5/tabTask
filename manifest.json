{
  "manifest_version": 3,
  "name": "TabTasks",
  "version": "1.0",
  "description": "A premium Todo list that keeps tasks unique to the current URL or shared globally.",
  "icons": {
    "16": "src/Assests/tabTaskIcon.png",
    "32": "src/Assests/tabTaskIcon.png",
    "48": "src/Assests/tabTaskIcon.png",
    "128": "src/Assests/tabTaskIcon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "sidePanel"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open TabTasks"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+U",
        "mac": "Command+U"
      },
      "description": "Open TabTasks"
    }
  }
}